{
  "manifest_version": 3,
  "name": "DSH no navegador",
  "short_name": "DSH",
  "version": "0.5.3",
  "description": "Converse com o DeepSeek Harness da sua mÃ¡quina de dentro do navegador, com a aba atual como contexto, leia tambÃ©m o conteÃºdo dentro de iframes, e deixe o agente agir na pÃ¡gina com a sua aprovaÃ§Ã£o.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "contextMenus",
    "sidePanel",
    "cookies",
    "clipboardRead",
    "clipboardWrite",
    "webNavigation"
  ],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH no navegador",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "side_panel": {
    "default_path": "painel/painel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" }
    },
    "abrir-painel": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Abrir o painel do DSH"
    },
    "usar-aba-atual": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Perguntar ao DSH sobre a aba atual"
    }
  }
}
