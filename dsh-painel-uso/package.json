{
  "name": "dsh-painel-uso",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de uso e janela de contexto no composer do DSH: contexto segmentado, tokens da sessao e estatisticas. Substitui o anel nativo.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
